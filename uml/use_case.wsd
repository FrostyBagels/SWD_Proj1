@startuml use_case
left to right direction
actor Student

rectangle "Student GPA System" {
    usecase "Sign Up" as UC1
    usecase "Log In" as UC2
    usecase "Sign Out" as UC3
    usecase "View Enrollments" as UC4
    usecase "View GPA" as UC5
    usecase "Add Enrollment" as UC6
    usecase "Update Grade" as UC7
    usecase "Delete Enrollment" as UC8
}

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Student --> UC7
Student --> UC8
@enduml
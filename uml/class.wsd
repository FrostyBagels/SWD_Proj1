@startuml class
left to right direction

class Course {
    - prefix: String
    - number: Int
    - name: String
    - credits: Int
}

class Enrollment{
    - user_id: String
    - course_prefix: String
    - course_number: Int
    - grade: String

}

class User {
    - name: String
    - id: String
    - about: String
    - passwd: Binary
}

User "1" *--> "0..N" Enrollment
Enrollment "1" *--> "0..N" Course

@enduml
